# Copy to .env and fill in. Never commit .env.

# Shared secret for POST /webhook/:name (sent as "Authorization: Bearer <secret>").
# Min 16 chars. Generate one with: openssl rand -hex 32
WEBHOOK_SECRET=replace-me-with-a-long-random-string

# Optional (defaults shown). The server always binds to 127.0.0.1.
PORT=8080
# DB_PATH=/Users/you/jarvis/data/jarvis.db

# Spotify (create an app at https://developer.spotify.com/dashboard).
# Register the redirect URI in the Spotify dashboard, exactly. By default it is
#   https://<PUBLIC_HOST>/spotify/callback   (PUBLIC_HOST defaults to jarvis.gurveerkhalsa.com)
# so you can log in from any device. Only set this to use a different one:
# SPOTIFY_REDIRECT_URI=https://your-tunnel-hostname/spotify/callback
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
# true = only log what would be liked. Set to false to really like songs.
SPOTIFY_DRY_RUN=true

# Expenses -> Google Sheet. Without these, expenses are still stored; the sync just waits.
# GOOGLE_SHEET_ID is the long id in the Sheet's URL (docs.google.com/spreadsheets/d/<ID>/edit).
# Share the Sheet with the service account's email as Editor. Keep the key file outside git
# (secrets/ is ignored) and run: chmod 600 secrets/google-sa.json
GOOGLE_SHEET_ID=your-sheet-id
GOOGLE_SERVICE_ACCOUNT_FILE=/Users/you/jarvis/secrets/google-sa.json
# Tab the rows are appended to (default Sheet1). Columns: Date, Merchant, Amount, Currency, Card, ID
# GOOGLE_SHEET_TAB=Sheet1

# Expenses from invoice emails (Gmail, read-only). Create an OAuth client (type "Web application")
# in Google Cloud and register this redirect URI exactly (default shown):
#   https://<PUBLIC_HOST>/gmail/callback
# then open https://<PUBLIC_HOST>/gmail/login once to connect. Override the URI only if needed:
# GMAIL_REDIRECT_URI=https://your-tunnel-hostname/gmail/callback
GMAIL_CLIENT_ID=your-oauth-client-id
GMAIL_CLIENT_SECRET=your-oauth-client-secret
# true = only log what would be added, write no expenses. Set to false to go live.
GMAIL_DRY_RUN=true
# Vercel AI Gateway key (model and spend caps live in src/ai/settings.ts).
AI_GATEWAY_API_KEY=your-ai-gateway-key

# Telegram bot (the chat interface). Create the bot with @BotFather (/newbot) and paste its token.
# Leave TELEGRAM_OWNER_ID unset at first: send /start to the bot and it replies (once) with your
# user id. Put that here and restart. Only that user is ever answered; everyone else is ignored.
TELEGRAM_BOT_TOKEN=your-bot-token
# TELEGRAM_OWNER_ID=123456789
# Expense questions ("What was this for?") stay OFF until you have received the test message.
TELEGRAM_QUESTIONS_ENABLED=false
# While your Google OAuth app is in "Testing", Google ends the Gmail login after 7 days. Set 7 here
# to get an alert before that; leave unset once the app is in production.
# GMAIL_CONSENT_DAYS=7

# Plans (Beeper chats -> plans.md -> Telegram pings -> Google Calendar). All optional until set up.
# Beeper Server (headless, localhost only). Token comes from signing the CLI in to the Server.
# BEEPER_BASE_URL=http://127.0.0.1:23373
# BEEPER_ACCESS_TOKEN=
# Safe by default: reads and detects, but never touches the calendar or sends pings.
PLANS_DRY_RUN=true
# Read every chat instead of only the allowlist in data/plans-chats.json.
PLANS_ALL_CHATS=false
# First start only: also read the last 7 days of the allowlisted chats (for testing).
PLANS_BACKFILL=false

# Event photos -> OneDrive (see README: Event photos). Safe by default: logs "would save", never downloads or uploads.
PHOTOS_DRY_RUN=true
# Photos count from the plan's end (default) or its start (also catches photos sent during the event).
# PHOTO_WINDOW_START=end
# A run = this many photos/videos from one sender, each within this many minutes of the previous.
# PHOTOS_MIN_RUN=4
# PHOTOS_RUN_GAP_MINUTES=10
# The Azure app (client) id for the personal OneDrive sign-in. Not secret; there is no client secret.
# MS_CLIENT_ID=
# Beeper Server's data folder (a downloaded file must be inside it).
# BEEPER_MEDIA_ROOT=/Users/you/beeper-prod-test/home/.beeper
