# Copy to .env and fill in. Never commit .env.

# Shared secret for POST /webhook/:name (sent as "Authorization: Bearer <secret>").
# Min 16 chars. Generate one with: openssl rand -hex 32
WEBHOOK_SECRET=replace-me-with-a-long-random-string

# Optional (defaults shown). The server always binds to 127.0.0.1.
PORT=8080
# DB_PATH=/Users/you/jarvis/data/jarvis.db

# Spotify (create an app at https://developer.spotify.com/dashboard).
# Register the redirect URI in the Spotify dashboard, exactly. By default it is
#   https://<PUBLIC_HOST>/spotify/callback   (PUBLIC_HOST defaults to jarvis.gurveerkhalsa.com)
# so you can log in from any device. Only set this to use a different one:
# SPOTIFY_REDIRECT_URI=https://your-tunnel-hostname/spotify/callback
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
# true = only log what would be liked. Set to false to really like songs.
SPOTIFY_DRY_RUN=true
